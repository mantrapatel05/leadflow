APP_NAME=LeadFlow API
APP_VERSION=0.1.0
APP_DESCRIPTION=Real-time Meta Lead Ads processing system

ENVIRONMENT=development
DEBUG=true

API_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://leadflow:your_password@localhost:5432/leadflow

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
